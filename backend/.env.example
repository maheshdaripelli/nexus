APP_NAME=Nexus API
APP_VERSION=1.0.0
DEBUG=true

API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Local PostgreSQL installed on Windows
# Put your actual local database credentials in backend/.env.
# Never commit backend/.env.
DATABASE_URL=postgresql+asyncpg://nexus_app:CHANGE_ME@localhost:5432/nexus

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default email provider: Google Apps Script (uses the Gmail account that owns the script).
# Deploy backend/google-apps-script/Code.gs as a web app, then configure the URL and shared token.
EMAIL_PROVIDER=google_apps_script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
GOOGLE_APPS_SCRIPT_SENDER_NAME=Nexus

# Optional Brevo provider (set EMAIL_PROVIDER=brevo).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nexus

# Optional local SMTP fallback (set EMAIL_PROVIDER=smtp).
EMAIL_FROM=Nexus
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Optional Resend provider (set EMAIL_PROVIDER=resend).
RESEND_API_KEY=
RESEND_FROM=Nexus <onboarding@resend.dev>
EMAIL_TEST_MODE=false

# Development comparison only. Keep credentials out of Git.
ENABLE_API_V2=false
RABBITMQ_URL=

# Optional V2 dashboard cache (TLS Redis URL, not REST URL).
ENABLE_REDIS_CACHE=false
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=30
